# Simple Dockerfile for local use that copies the already-built jar from target
FROM eclipse-temurin:17-jre
WORKDIR /app

# Copy the jar built on the host into the image. Adjust filename if your artifactId/version differ.
COPY target/aurea-backend-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/app.jar"]

